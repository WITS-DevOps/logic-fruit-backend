# Server Port
PORT=5000

# Client URL for CORS (Frontend URL)
CLIENT_URL=http://localhost:5173

# Database Settings (AWS DynamoDB)
DYNAMODB_TABLE_NAME=logicfruit_cms

# ==========================================
# Local Storage Mode (Toggle for Testing)
# ==========================================
# Set to 'true' to store uploads in 'uploads/' and CMS data in 'data/local_db.json'
# Set to 'false' or leave blank to strictly use AWS S3 and AWS DynamoDB
USE_LOCAL_STORAGE=false

# AWS S3 Settings (For image and PDF uploads when USE_LOCAL_STORAGE is false)
# Set your AWS region (e.g., ap-south-1, us-east-1)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_if_using_temporary_credentials
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here

# ==========================================
# Email Configuration (Google Workspace SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@logic-fruit.com
SMTP_PASS=your_google_app_password_here
MAIL_FROM="Logic Fruit Technologies" <info@logic-fruit.com>
ADMIN_NOTIFICATION_EMAIL=info@logic-fruit.com

