# Server Port (used when running locally)
PORT=5000

# Public base URL of the backend server (used to build image/media URLs stored in the database)
# IMPORTANT: Set this to your production API domain, otherwise images will be stored with localhost URLs!
# Production: https://api.logic-fruit.com
# Local: http://localhost:5000
BASE_URL=https://api.logic-fruit.com

# Client URLs allowed for CORS (comma-separated if multiple)
# Production: https://logic-fruit.com, https://www.logic-fruit.com
# Staging: https://logic-fruit-ui.vercel.app
# Local development: http://localhost:5173
CLIENT_URL=https://logic-fruit.com,https://www.logic-fruit.com,http://localhost:5173,https://logic-fruit-ui.vercel.app

# Staging Environment URL (used to detect staging requests and show staging-only products)
STAGING_URL=https://logic-fruit-ui.vercel.app


# Database Settings (AWS DynamoDB)
DYNAMODB_TABLE_NAME=logicfruit_cms

# ==========================================
# Local Storage Mode (Toggle for Testing)
# ==========================================
# Set to 'true' to store uploads in 'uploads/' and CMS data in 'data/local_db.json'
# Set to 'false' or leave blank to strictly use AWS S3 and AWS DynamoDB
USE_LOCAL_STORAGE=false

# AWS S3 Settings (For image and PDF uploads when USE_LOCAL_STORAGE is false)
# Set your AWS region (e.g., ap-south-1, us-east-1)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_if_using_temporary_credentials
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here

# ==========================================
# Email Configuration (Google Workspace SMTP)
# ==========================================
# Set to 'true' to actually send emails, 'false' to skip (logs only)
ENABLE_EMAILS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@logic-fruit.com
SMTP_PASS=your_google_app_password_here
MAIL_FROM="Logic Fruit Technologies" <info@logic-fruit.com>
ADMIN_NOTIFICATION_EMAIL=info@logic-fruit.com
# Single environment variable to configure who receives internal lead notification emails:
# You can set a single email or multiple comma-separated emails.
INTERNAL_LEAD_EMAILS=jaswant.singh@logic-fruit.com,meenu.kukreja@logic-fruit.com
LEAD_NOTIFICATION_EMAILS=jaswant.singh@logic-fruit.com,meenu.kukreja@logic-fruit.com
CAREERS_NOTIFICATION_EMAIL=careers@logic-fruit.com


