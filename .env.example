# Server Port
PORT=5000

# Client URL for CORS (Frontend URL)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/logic_fruit_cms
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/logic_fruit_cms?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/logic_fruit_cms

# AWS S3 Settings (For image and PDF uploads)
# Set your AWS region (e.g., ap-south-1, us-east-1)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here

# Note: If AWS credentials are empty, files will automatically save locally in the "uploads" folder for testing!
